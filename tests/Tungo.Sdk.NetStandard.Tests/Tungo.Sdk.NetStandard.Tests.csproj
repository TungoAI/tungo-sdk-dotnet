<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generated by tungo-sdkgen. Do not edit. The same tests, compiled against the netstandard2.0 build of the
    library (the one .NET Framework, Mono and Unity load) and run on .NET 8.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Tungo.Sdk.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CS0436: the library's internal polyfills (IsExternalInit, ...) are visible here and shadow the framework's. -->
    <NoWarn>$(NoWarn);CS0436;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dependencies of the netstandard2.0 build do not flow through a reference with a forced target framework. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Tungo.Sdk/Tungo.Sdk.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <Compile Include="../Tungo.Sdk.Tests/**/*.cs" Exclude="../Tungo.Sdk.Tests/bin/**;../Tungo.Sdk.Tests/obj/**" LinkBase="Shared" />
    <None Include="../../conformance/vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
